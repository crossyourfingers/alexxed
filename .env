# SpacetimeDB Configuration
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=alexxed-u3k4f

# ============================================
# Authentication Mode
# ============================================
# Set to 'true' for anonymous mode (no SpacetimeAuth, instant access)
# Set to 'false' or omit for SpacetimeAuth mode (dashboard integration)
VITE_USE_ANONYMOUS_AUTH=true

# ============================================
# SpacetimeAuth Configuration (only needed when VITE_USE_ANONYMOUS_AUTH=false)
# ============================================
# Get your Client ID from https://spacetimedb.com (Auth Dashboard)
VITE_SPACETIMEAUTH_CLIENT_ID=client_032ZYiWSDQ0qOoppFjPCGz

# After changing auth mode or Client ID, restart your dev server (npm run dev)
