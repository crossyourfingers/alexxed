# SpacetimeDB Configuration
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=alexxed-u3k4f

# ============================================
# Authentication Mode
# ============================================
# Set to 'true' for anonymous mode (no SpacetimeAuth, instant access)
# Set to 'false' or omit for SpacetimeAuth mode (dashboard integration)
VITE_USE_ANONYMOUS_AUTH=true

# ============================================
# SpacetimeAuth Configuration (only needed when VITE_USE_ANONYMOUS_AUTH=false)
# ============================================
# Get your Client ID from https://spacetimedb.com (Auth Dashboard)
# 1. Go to https://spacetimedb.com
# 2. Navigate to Auth Dashboard
# 3. Create a project or use existing
# 4. Copy the Client ID and paste below
VITE_SPACETIMEAUTH_CLIENT_ID=

# ============================================
# How to Switch Auth Modes:
# ============================================
# Anonymous Mode (default for dev):
#   VITE_USE_ANONYMOUS_AUTH=true
#   - Users auto-login with random names like "SwiftRaven42"
#   - No external auth provider needed
#   - Great for development and testing
#
# SpacetimeAuth Mode (for production):
#   VITE_USE_ANONYMOUS_AUTH=false
#   - Users appear in SpacetimeAuth dashboard
#   - Requires VITE_SPACETIMEAUTH_CLIENT_ID
#   - Full OAuth2/OIDC authentication
#
# After changing modes, restart your dev server (npm run dev)

# ============================================
# Alternative OAuth2 Providers (if switching from SpacetimeAuth)
# ============================================
# Auth0
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=your_auth0_client_id

# Clerk
# VITE_CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
# VITE_CLERK_CLIENT_ID=your_clerk_client_id
