# SpacetimeDB Configuration
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=alexxed-u3k4f

# SpacetimeAuth Configuration
# Obtain your Client ID from the SpacetimeAuth dashboard:
# https://spacetimedb.com
VITE_SPACETIMEAUTH_CLIENT_ID=

# After changing the Client ID, restart your dev server (npm run dev)

# ============================================
# Alternative OAuth2 Providers (optional)
# ============================================
# Auth0
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=your_auth0_client_id

# Clerk
# VITE_CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
# VITE_CLERK_CLIENT_ID=your_clerk_client_id

# Google Sheets API (for library seeding)
# GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
